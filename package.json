{
  "name": "planer-server",
  "version": "0.1.0",
  "private": true,
  "description": "Gemeinsamer Echtzeit-Server für Netzwerkplaner und Stromplaner: eigene Sitzungen je App, Operationen mit Versionsnummer",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node dist/server.js",
    "dev": "node scripts/build.js && node dist/server.js",
    "test": "node scripts/build.js --test && node --test dist-test/*.test.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "engines": { "node": ">=20" }
}
